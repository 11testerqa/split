{
  "name": "splitpop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:ocr && vite --host 0.0.0.0",
    "build": "npm run prepare:ocr && tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests *.ts *.json index.html README.md .github",
    "prepare:ocr": "node scripts/copy-ocr-assets.mjs",
    "test:db": "node scripts/test-database.mjs",
    "benchmark:ocr": "node --import tsx scripts/benchmark-ocr.ts",
    "fixtures:ocr": "node scripts/generate-ocr-fixture.mjs",
    "test:live": "playwright test -c playwright.live.config.ts",
    "test:parity": "node --import tsx scripts/test-financial-parity.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "decimal.js": "^10.6.0",
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
